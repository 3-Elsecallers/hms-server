model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String   @unique
  emailVerified Boolean  @default(false)
  password      String
  role          Role     @default(GUEST)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  auditLogs AuditLog[]
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String   @unique
  expiresAt Int      @default(dbgenerated("NOW() + INTERVAL '5 minutes'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt Int      @default(dbgenerated("NOW() + INTERVAL '10 minutes'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  PATIENT
  PHARMACIST
  ACCOUNTANT
  LAB_TECHNICIAN
  RECEPTIONIST
  GUEST
}
